# ═══════════════════════════════════════════════════════════════════════
# ZOHO CATALYST CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Your Catalyst Project ID (found in Project Settings → General)
VITE_CATALYST_PROJECT_ID=your_project_id

# Your Catalyst ZAID / Project Key
VITE_CATALYST_PROJECT_KEY=your_project_key

# API Domain based on your data center:
#   US: https://api.catalyst.zoho.com
#   EU: https://api.catalyst.zoho.eu
#   IN: https://api.catalyst.zoho.in
#   AU: https://api.catalyst.zoho.com.au
#   CA: https://api.catalyst.zohocloud.ca
#   JP: https://api.catalyst.zoho.jp
#   SA: https://api.catalyst.zoho.sa
VITE_CATALYST_API_DOMAIN=https://api.catalyst.zoho.in

# Optional: Organization ID (multi-org support)
VITE_CATALYST_ORG_ID=

# Auth mode: 'catalyst' for hosted auth, 'custom' for API-based
VITE_AUTH_MODE=custom

# ═══════════════════════════════════════════════════════════════════════
# SERVER-SIDE ONLY (Vercel serverless functions)
# ═══════════════════════════════════════════════════════════════════════

# Catalyst server-side OAuth access token (for admin API calls)
CATALYST_SERVER_TOKEN=your_server_oauth_token
CATALYST_PROJECT_ID=your_project_id
CATALYST_PROJECT_KEY=your_project_key
CATALYST_API_DOMAIN=https://api.catalyst.zoho.in

# Zoho OAuth Credentials (for Google sign-in flow)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=https://your-domain.com/api/auth/callback

# Site URL
SITE_URL=https://your-domain.com

# ═══════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (Resend)
# ═══════════════════════════════════════════════════════════════════════

RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@zped.org
ADMIN_EMAIL=zenithpranavi786@gmail.com
